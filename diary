<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="일기장">
<title>내 일기장</title>
<style>
:root{--bg:#fbf8f3;--card:#fff;--text:#2b2623;--sub:#8a817a;--accent:#d9774a;--line:#ece5dc;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1c1917;--card:#292524;--text:#f3ede6;--sub:#a39a92;--accent:#e8895c;--line:#3a3532;color-scheme:dark}}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,"Apple SD Gothic Neo","Noto Sans KR",sans-serif;min-height:100vh}
header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px 8px}
h1{font-size:26px;margin:0}
button{font:inherit;border:0;cursor:pointer}
.add{background:var(--accent);color:#fff;width:40px;height:40px;border-radius:50%;font-size:24px;line-height:1}
main{padding:8px 16px 40px;max-width:640px;margin:0 auto}
.empty{text-align:center;color:var(--sub);margin-top:80px;line-height:1.7}
.item{display:block;width:100%;text-align:left;background:var(--card);color:var(--text);border-radius:14px;padding:14px 16px;margin-bottom:10px;border:1px solid var(--line)}
.item small{color:var(--sub)}
.item b{display:block;margin:4px 0;font-size:17px}
.item p{margin:0;color:var(--sub);font-size:14px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;white-space:pre-wrap}
#editor{position:fixed;inset:0;background:var(--bg);display:none;flex-direction:column;padding:calc(env(safe-area-inset-top,0px) + 12px) 16px calc(env(safe-area-inset-bottom,0px) + 12px)}
#editor.open{display:flex}
.bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.bar button{background:none;color:var(--accent);font-size:16px;padding:8px 4px}
.bar .del{color:#d64545}
input,textarea{width:100%;background:var(--card);color:var(--text);border:1px solid var(--line);border-radius:12px;padding:12px;font:inherit;font-size:16px;margin-bottom:10px}
textarea{flex:1;resize:none}
.moods{display:flex;justify-content:space-between;margin-bottom:10px}
.moods button{font-size:28px;background:var(--card);border:2px solid transparent;border-radius:12px;padding:6px 8px}
.moods button.on{border-color:var(--accent)}
</style>
</head>
<body>
<header><h1>내 일기장</h1><button class="add" id="new" aria-label="새 일기">+</button></header>
<main id="list"></main>

<div id="editor">
  <div class="bar"><button id="cancel">취소</button><button class="del" id="del">삭제</button><button id="save"><b>저장</b></button></div>
  <input type="date" id="date">
  <div class="moods" id="moods"></div>
  <input type="text" id="title" placeholder="제목">
  <textarea id="text" placeholder="오늘은 어땠나요?"></textarea>
</div>

<script>
let entries = [];
try { entries = JSON.parse(localStorage.getItem('diary') || '[]'); } catch (e) {}
let current = null;
const $ = id => document.getElementById(id);

function persist() { try { localStorage.setItem('diary', JSON.stringify(entries)); } catch (e) {} }
function today() { const d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); }

function render() {
  const list = $('list');
  list.textContent = '';
  if (!entries.length) {
    const p = document.createElement('div');
    p.className = 'empty';
    p.innerHTML = '아직 일기가 없어요.<br>오른쪽 위 + 버튼으로 첫 일기를 써보세요.';
    list.appendChild(p);
    return;
  }
  entries.sort((a, b) => b.date.localeCompare(a.date) || b.id - a.id).forEach(e => {
    const b = document.createElement('button');
    b.className = 'item';
    const s = document.createElement('small'); s.textContent = e.date;
    const t = document.createElement('b'); t.textContent = (e.mood ? e.mood + ' ' : '') + (e.title || '제목 없음');
    const p = document.createElement('p'); p.textContent = e.text;
    b.append(s, t, p);
    b.onclick = () => openEditor(e);
    list.appendChild(b);
  });
}

function openEditor(e) {
  current = e ? { ...e } : { id: Date.now(), date: today(), title: '', text: '', mood: '' };
  $('date').value = current.date;
  $('title').value = current.title;
  $('text').value = current.text;
  setMood(current.mood || '');
  $('del').style.visibility = e ? 'visible' : 'hidden';
  $('editor').classList.add('open');
}
function closeEditor() { $('editor').classList.remove('open'); current = null; }

const MOODS = ['😄', '😊', '😐', '😢', '😡', '😴'];
function setMood(m) {
  current.mood = m;
  [...$('moods').children].forEach(b => b.classList.toggle('on', b.textContent === m));
}
MOODS.forEach(m => {
  const b = document.createElement('button');
  b.textContent = m;
  b.onclick = () => setMood(current.mood === m ? '' : m);
  $('moods').appendChild(b);
});

$('new').onclick = () => openEditor();
$('cancel').onclick = closeEditor;
$('save').onclick = () => {
  const e = { id: current.id, date: $('date').value || today(), title: $('title').value.trim(), text: $('text').value, mood: current.mood || '' };
  if (!e.title && !e.text.trim()) { closeEditor(); return; }
  const i = entries.findIndex(x => x.id === e.id);
  if (i >= 0) entries[i] = e; else entries.push(e);
  persist(); closeEditor(); render();
};
$('del').onclick = () => {
  if (!confirm('이 일기를 삭제할까요?')) return;
  entries = entries.filter(x => x.id !== current.id);
  persist(); closeEditor(); render();
};
render();
</script>
</body>
</html>